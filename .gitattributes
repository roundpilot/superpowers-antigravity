# Ensure shell scripts always have LF line endings
*.sh text eol=lf

# Tab-separated purity-law data, read by bash and node (by exact path, not *.txt: five prompt files are CRLF)
tests/antigravity/purity-patterns.txt text eol=lf
tests/antigravity/known-tools.txt text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary
